{
  "expo": {
    "name": "YOLI APP",
    "slug": "yoli-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yoliapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.yoli.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F26B1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yoli.app",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F26B1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "YOLI APP usa tus fotos para las imágenes de los productos.",
          "cameraPermission": "YOLI APP usa la cámara para tomar fotos de los productos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "16d97026-ca79-4393-a846-8dff35df5848"
      }
    },
    "owner": "andronik01"
  }
}
